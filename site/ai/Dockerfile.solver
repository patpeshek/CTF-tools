# Образ для запуска решателей, написанных ИИ, в изоляции (агент-цикл).
# Намеренно без сети на запуске (docker run --network none) и без лишнего:
# только Python + типовые CTF-крипто/мат-библиотеки.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    pycryptodome \
    sympy \
    numpy \
    pillow \
    requests

# Непривилегированный пользователь; рабочая папка монтируется снаружи.
RUN useradd -u 10000 -m solver || true
WORKDIR /work
USER 10000
